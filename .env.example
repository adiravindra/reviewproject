# Choose one provider. Google Gemini is the default.
REVIEWINSIGHT_LLM_PROVIDER=google
REVIEWINSIGHT_LLM_MODEL=gemini-2.5-flash-lite

# Set only the key for the selected provider. Never commit real values.
GOOGLE_API_KEY=
GROQ_API_KEY=

# Local website-level history database.
REVIEWINSIGHT_DB_PATH=data/reviewinsight.db

# Optional stricter demo limits. Values above the hard ceilings are clamped.
REVIEWINSIGHT_MAX_RESPONSE_BYTES=2097152
REVIEWINSIGHT_MAX_PAGES=3
REVIEWINSIGHT_SCRAPE_DEADLINE_SECONDS=25
REVIEWINSIGHT_CONNECT_TIMEOUT_SECONDS=5
REVIEWINSIGHT_READ_TIMEOUT_SECONDS=10
REVIEWINSIGHT_MAX_REDIRECTS=5
REVIEWINSIGHT_MAX_REVIEWS=60
REVIEWINSIGHT_LLM_BATCH_SIZE=15
REVIEWINSIGHT_MAX_BATCH_CALLS=4
REVIEWINSIGHT_MAX_SYNTHESIS_CALLS=1
REVIEWINSIGHT_MAX_LLM_CALLS=5
REVIEWINSIGHT_PROVIDER_TIMEOUT_SECONDS=20
REVIEWINSIGHT_OVERALL_DEADLINE_SECONDS=120
REVIEWINSIGHT_MIN_REVIEWS=2
REVIEWINSIGHT_LOW_SAMPLE_THRESHOLD=5
